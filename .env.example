# Copy to .env and fill in real values. Never commit the populated file.

# REQUIRED. At least 32 random bytes. Generate with:  openssl rand -hex 32
# There is deliberately no default in application.yml: a committed signing key
# would let anyone who reads the repository mint a valid token for any account,
# including administrators.
JWT_SECRET_KEY=

# REQUIRED. The Postgres password. There is deliberately no default in
# application.yml either: a committed database password is a hardcoded secret
# no matter how many times it is called a "dev default". This one value drives
# both sides — the Postgres container and the backend — so they cannot
# disagree. The stack refuses to start without it.
DB_PASSWORD=

# Optional overrides.
#
# These are read by a local run (mvn spring-boot:run with the variables exported
# in your shell). The compose stack does NOT read them: it sets the service
# names itself, because inside a container `localhost` is the container and every
# one of these has to point somewhere else. That difference is the reason
# DB_HOST and REDIS_HOST exist at all.
#
# DB_HOST=localhost
# DB_PORT=5432
# REDIS_HOST=localhost
# REDIS_PORT=6379
# DB_NAME=delivery_db
# DB_USERNAME=admin
# DB_PASSWORD is required (see above), not optional: it must match the
# Postgres container, and the application has no default for it.
# OSRM_BASE_URL=http://localhost:5000
# JWT_EXPIRATION=86400000
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://swiftdeliver-frontend.onrender.com
# JPA_SHOW_SQL=false
# JPA_FORMAT_SQL=false
# JPA_DDL_AUTO=update

# Passive field-data collection (#5a). Disabled by default. Enable only for a
# consented field campaign; see FIELD_COLLECTION.md before flipping it.
# FIELD_COLLECTION_ENABLED=false
# FIELD_COLLECTION_REQUIRE_CONSENT=true
# FIELD_COLLECTION_RETENTION_DAYS=90

# Basemap tiles. Defaults to the public OpenStreetMap raster tiles, which are
# free but rate-limited and have a usage policy that discourages application
# use. Set this to your own tile server to remove the external dependency; the
# {z}/{x}/{y} placeholders are expanded by Leaflet.
# NEXT_PUBLIC_TILE_URL=/tiles/{z}/{x}/{y}.png
