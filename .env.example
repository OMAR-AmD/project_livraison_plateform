# Copy to .env and fill in real values. Never commit the populated file.

# REQUIRED. At least 32 random bytes. Generate with:  openssl rand -hex 32
# There is deliberately no default in application.yml: a committed signing key
# would let anyone who reads the repository mint a valid token for any account,
# including administrators.
JWT_SECRET_KEY=

# Optional overrides
# DB_NAME=delivery_db
# DB_USERNAME=admin
# DB_PASSWORD=password123
# OSRM_BASE_URL=http://localhost:5000
# JWT_EXPIRATION=86400000

# Basemap tiles. Defaults to the public OpenStreetMap raster tiles, which are
# free but rate-limited and have a usage policy that discourages application
# use. Set this to your own tile server to remove the external dependency; the
# {z}/{x}/{y} placeholders are expanded by Leaflet.
# NEXT_PUBLIC_TILE_URL=/tiles/{z}/{x}/{y}.png
