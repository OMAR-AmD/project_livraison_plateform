# Git Ignore Rules for Plateforme Livraison

# ============================================
# BACKEND (Spring Boot / Maven)
# ============================================

# Maven
backend/target/
backend/.classpath
backend/.project
backend/.settings/
backend/.prefs
backend/*.jar
backend/pom.xml.bak

# Maven Wrapper
# The wrapper MUST be committed. Without backend/.mvn/wrapper/maven-wrapper.properties
# a fresh clone has no ./mvnw and the documented build command cannot run.
# Only the legacy wrapper jar is ignored; this project uses the 3.2+ style
# wrapper, which reads distributionUrl and downloads Maven itself.
backend/.mvn/wrapper/maven-wrapper.jar

# Java
backend/*.class
backend/*.jar
backend/*.war
backend/*.ear

# Spring Boot
backend/build/
backend/out/

# IDE
backend/.vscode/
backend/.idea/
backend/.DS_Store
backend/*.iml
backend/.gradle/

# ============================================
# FRONTEND (Next.js / React)
# ============================================

# Node modules
frontend/node_modules/
frontend/yarn.lock

# package-lock.json is deliberately NOT ignored, despite being the convention
# for a library. This is an application: the lockfile pins the exact dependency
# tree that CI (npm ci), the Dockerfile (npm ci) and every teammate install, so
# the three cannot drift. Ignoring it here would mean a fresh clone has no
# lockfile and `npm ci` fails outright rather than resolving something new.

# Next.js
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/

# Environment files (local)
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Misc
frontend/.DS_Store
frontend/thumbs.db
frontend/*.pem
frontend/.eslintcache

# IDE
frontend/.vscode/
frontend/.idea/
frontend/*.swp
frontend/*.swo

# ============================================
# IDE & EDITOR
# ============================================

.vscode/
.idea/
.eclipse/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.iml
*.iws
*.ipr

# ============================================
# OS SPECIFIC
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
.gvfs

# ============================================
# DOCKER
# ============================================

docker-compose.override.yml
.docker/
docker/secrets/

# Database volumes (local)
pgdata/
redisdata/

# ============================================
# LOGS
# ============================================

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed

# ============================================
# TEMPORARY FILES
# ============================================

*.tmp
*.bak
*.backup
*.swp
*.swo
*~
.cache/
tmp/
temp/

# ============================================
# BUILD ARTIFACTS
# ============================================

dist/
build/
*.exe
*.o
*.so

# ============================================
# DEPENDENCIES (if committed)
# ============================================

# Don't commit installed dependencies
# They should be installed fresh with:
# Backend: mvn install
# Frontend: npm install

# ============================================
# ENVIRONMENT & CONFIGURATION
# ============================================

# Local environment files (never commit these!)
.env
.env.local
.env.*.local

# Local application configuration
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-dev.yml

# ============================================
# CREDENTIALS & SECRETS
# ============================================

# Never commit these!
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
credentials.json
secrets/
.aws/credentials

# ============================================
# GRADLE (if added in future)
# ============================================

.gradle/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
build/

# ============================================
# CUSTOM RULES FOR THIS PROJECT
# ============================================

# Database snapshots (local testing)
*.sql
*.sql.gz
# ...except the bootstrap script docker-compose mounts into
# /docker-entrypoint-initdb.d. It is required, not a snapshot: it creates the
# pgvector extension, without which a fresh clone builds an empty vector store
# and silently disables the FAQ assistant. Do not remove this negation unless
# init.sql is deleted from docker-compose.yml as well.
!init.sql

# Report files
reports/
coverage/

# ============================================
# VCS (Version Control System)
# ============================================

.git/

# ============================================
# NOTES TO SELF
# ============================================

NOTES.md
TODO_LOCAL.md
FIXME.md

# ============================================
# PLATFORM SPECIFIC
# ============================================

# Node version manager
.nvm
.nvmrc

# Python (if added)
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/

# ============================================
# KEEP THESE COMMITTED
# ============================================

# Build configuration files
!backend/pom.xml
!frontend/package.json
!frontend/package-lock.json
!frontend/next.config.mjs
!frontend/tsconfig.json

# Documentation
!*.md
!.github/
!.gitignore

# Configuration files
!docker-compose.yml
!backend/src/main/resources/application.yml
!frontend/.eslintrc.json

# OSRM Data
osrm-data/

# Editor / AI tool settings
.cursor/
